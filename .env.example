# Supabase > Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Service role key / Secret key (RAHASIA — jangan pernah di-commit ke GitHub)
SUPABASE_SERVICE_ROLE_KEY=isi-service-role-key-anda
# String acak minimal 32 karakter untuk menandatangani sesi login.
# Buat dengan:  openssl rand -base64 48
AUTH_SECRET=ganti-dengan-string-acak-panjang-minimal-32-karakter
